# ---------------------------------------------------------------- installed
node_modules/
build/

# ------------------------------------------------------------------- secrets
# .env holds the real DB password, JWT secret and SendGrid key. Only
# .env.example - which carries the key names and no values - is committed.
.env
.env.local
.env.*.local

# ------------------------------------------------------------ runtime output
# Uploaded evidence and generated workbooks/reports. Data, not source.
TPRM_file_uploads/

# Exports the app hands the browser land wherever the download path points,
# which is often the repo root. They are output of a test run, not source.
dTPRM_*.pdf
dTPRM_*.xlsx

npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# --------------------------------------------------------------------- tests
coverage/

# ------------------------------------------------------------------ editors
# .vscode/launch.json IS committed on purpose - it is what makes F5 start the
# backend for everyone on the team.
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*~

# ---------------------------------------------------------------------- os
.DS_Store
Thumbs.db
desktop.ini
