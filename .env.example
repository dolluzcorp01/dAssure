# ------------------------------------------------------------------ runtime
# Backend API port. Deliberately NOT called PORT: react-scripts reads PORT
# from this same file, and would start the frontend dev server on it.
TPRM_PORT=
REACT_APP_API=
TPRM_PUBLIC_URL=

# ----------------------------------------------------------------- database
# Same MySQL server as the other dApps. dAssure reads dadmin.employee for login
# and owns the `dtprm` database for everything else.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --------------------------------------------------------------------- auth
# Must match the JWT_SECRET used by dAdmin so a single sign-on cookie works.
JWT_SECRET=

# --------------------------------------------------------------------- mail
# Leave TPRM_MAIL_DRIVER=outbox to queue mail in the database without sending.
# Set to sendgrid and supply the key to actually deliver.
TPRM_MAIL_DRIVER=
SENDGRID_API_KEY=
# All mail is sent through this mailbox.
TPRM_MAIL_FROM=
# The address readers are given: reply-to, and the "please contact" line in
# every template. connect@ is never presented to a reader as a contact.
TPRM_MAIL_CONTACT=
# Copied in only when TPRM_MAIL_CONTACT is one of the recipients.
TPRM_MAIL_ADMIN_CC=
TPRM_MAIL_FROM_NAME=

# ------------------------------------------------------------------ storage
TPRM_STORAGE_DIR=
